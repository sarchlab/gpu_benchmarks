# Compiled binaries (executables with no extension in benchmark dirs)
# Tier 1 and Tier 2 benchmarks keep one source tree per platform:
# tier<N>/<bench>/hip/ (original HIP sources) and tier<N>/<bench>/cuda/
# (native CUDA port). Keep sources, ignore built binaries.
tier1/*/*
!tier1/*/hip/
!tier1/*/cuda/
tier1/*/hip/*
tier1/*/cuda/*
!tier1/*/hip/Makefile
!tier1/*/hip/README.md
!tier1/*/hip/*.hip
!tier1/*/hip/*.h
!tier1/*/hip/params.json
!tier1/*/hip/.gitkeep
!tier1/*/cuda/Makefile
!tier1/*/cuda/README.md
!tier1/*/cuda/*.cu
!tier1/*/cuda/*.h
!tier1/*/cuda/params.json
tier2/*/*
!tier2/*/hip/
!tier2/*/cuda/
tier2/*/hip/*
tier2/*/cuda/*
!tier2/*/hip/Makefile
!tier2/*/hip/README.md
!tier2/*/hip/*.hip
!tier2/*/hip/*.h
!tier2/*/hip/params.json
!tier2/*/hip/UPSTREAM_LICENSE
!tier2/*/hip/h100_profile.json
!tier2/*/hip/.gitignore
!tier2/npb_is/hip/test_npb_is.py
!tier2/*/cuda/Makefile
!tier2/*/cuda/README.md
!tier2/*/cuda/*.cu
!tier2/*/cuda/*.h
!tier2/*/cuda/params.json
!tier2/*/cuda/UPSTREAM_LICENSE
!tier2/npb_is/cuda/test_npb_is.py
tier3/*/*
!tier3/*/Makefile
!tier3/*/README.md
!tier3/*/bench.cu
!tier3/*/bench.hip
!tier3/*/*.hip
!tier3/*/*.cu
!tier3/*/*.h
!tier3/*/*.metal
!tier3/*/*.mm
tier4/babelstream/babelstream

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Build artifacts
*.o
*.a
*.so
*.d

# Results directory
results/

# Go binary (root-level compiled binary only)
/gpubench

# macOS
.DS_Store

# Workspace (agent workspace, not tracked)
workspace/

# Bot infrastructure (not part of project)
repo/
repo-chat/
config.yaml

# Database files
*.db
*.db-shm
*.db-wal

# Benchmark output artifacts
/perf_charts/
/traces/
/new_traces/
/.matplotlib-cache/

# Generated documentation
/docs/parameter_selection.md

# Local trace wrapper with machine-specific paths
/run_traces.sh

# Compile logs
compile_errors.log

# Output logs
*.out

# Local agent state
/.codex

# Status dashboard dependencies/build output
/status-dashboard/node_modules/
/status-dashboard/dist/

# scripts/trace_collect.py working files: only the scripts themselves are tracked
scripts/logs/
scripts/tmp/
scripts/.build/

ground_truth_h100/
ground_truth_h100_all/
gt_smoke/
run_ground_truth*.py