# Compiled binaries (executables with no extension in benchmark dirs)
tier1/*/bench
tier1/*/bench_*
tier1/atomic_operations/atomic_operations
tier1/cache_bandwidth/cache_bandwidth
tier1/cache_latency/cache_latency
tier1/empty_kernel/empty_kernel
tier1/fp16_throughput/fp16_throughput
tier1/fp32_throughput/fp32_throughput
tier1/fp64_throughput/fp64_throughput
tier1/int32_throughput/int32_throughput
tier1/memory_bandwidth/memory_bandwidth
tier1/mixbench/mixbench
tier1/pcie_bandwidth/pcie_bandwidth
tier1/shared_mem_bandwidth/shared_mem_bandwidth
tier1/warp_shuffle/warp_shuffle
# Each tier2 benchmark keeps one source tree per platform: tier2/<bench>/hip/
# (original HIP sources) and tier2/<bench>/cuda/ (native CUDA port). Keep
# sources, ignore built binaries.
tier2/*/*
!tier2/*/hip/
!tier2/*/cuda/
tier2/*/hip/*
tier2/*/cuda/*
!tier2/*/hip/Makefile
!tier2/*/hip/README.md
!tier2/*/hip/*.hip
!tier2/*/hip/*.h
!tier2/*/hip/params.json
!tier2/*/hip/UPSTREAM_LICENSE
!tier2/*/hip/h100_profile.json
!tier2/*/hip/.gitignore
!tier2/npb_is/hip/test_npb_is.py
!tier2/*/cuda/Makefile
!tier2/*/cuda/README.md
!tier2/*/cuda/*.cu
!tier2/*/cuda/*.h
!tier2/*/cuda/params.json
!tier2/*/cuda/UPSTREAM_LICENSE
!tier2/npb_is/cuda/test_npb_is.py
tier3/*/*
!tier3/*/Makefile
!tier3/*/README.md
!tier3/*/bench.cu
!tier3/*/bench.hip
!tier3/*/*.hip
!tier3/*/*.cu
!tier3/*/*.h
!tier3/*/*.metal
!tier3/*/*.mm
tier4/babelstream/babelstream

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Build artifacts
*.o
*.a
*.so
*.d

