#!/usr/bin/env python3
"""gpubench — GPU Benchmark Suite CLI tool.

Discovers, compiles, runs, and validates GPU benchmarks.
Stores results in an SQLite database.

Commands: list, compile, run, info, validate
"""
from __future__ import print_function
import argparse, datetime, glob, itertools, json, os, platform, re, signal
import socket, sqlite3, subprocess, sys, time

# Exit codes
EXIT_OK, EXIT_SOME_FAILED, EXIT_USAGE, EXIT_NO_BENCH, EXIT_DB, EXIT_INT = (
    0, 1, 2, 3, 4, 130
)
DEFAULT_REPS, DEFAULT_DB, DEFAULT_TIMEOUT = 7, "results.db", 300

# Embedded SQLite schema from docs/schema.sql
SCHEMA_SQL = """
PRAGMA journal_mode = WAL;
PRAGMA foreign_keys = ON;
CREATE TABLE IF NOT EXISTS platforms (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    hostname TEXT NOT NULL, os TEXT NOT NULL,
    cpu_model TEXT, cpu_cores INTEGER, ram_gb REAL,
    gpu_model TEXT NOT NULL, gpu_vram_gb REAL,
    gpu_count INTEGER DEFAULT 1, driver_version TEXT,
    runtime_version TEXT, compiler TEXT,
    platform_type TEXT NOT NULL, python_version TEXT,
    extra_json TEXT,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_platform_fingerprint
    ON platforms (hostname, gpu_model, driver_version, os, platform_type);
CREATE TABLE IF NOT EXISTS sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    platform_id INTEGER NOT NULL REFERENCES platforms(id),
    command_line TEXT,
    started_at TEXT NOT NULL DEFAULT (datetime('now')),
    finished_at TEXT,
    status TEXT NOT NULL DEFAULT 'running',
    repetitions INTEGER NOT NULL DEFAULT 7,
    filter_tier TEXT, filter_suite TEXT, filter_bench TEXT,
    notes TEXT
);
CREATE INDEX IF NOT EXISTS idx_session_platform ON sessions(platform_id);
CREATE TABLE IF NOT EXISTS runs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id INTEGER NOT NULL REFERENCES sessions(id),
    tier INTEGER NOT NULL, suite TEXT NOT NULL,
    benchmark TEXT NOT NULL,
    scaling_param_name TEXT NOT NULL,
    scaling_param_value TEXT NOT NULL,
    non_scaling_params_json TEXT NOT NULL DEFAULT '{}',
    repetition INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'ok',
    error_message TEXT, total_time_ms REAL,
    exit_code INTEGER,
    started_at TEXT NOT NULL DEFAULT (datetime('now')),
    finished_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_run_session ON runs(session_id);
CREATE INDEX IF NOT EXISTS idx_run_benchmark ON runs(tier, suite, benchmark);
CREATE INDEX IF NOT EXISTS idx_run_scaling ON runs(benchmark, scaling_param_name, scaling_param_value);
CREATE TABLE IF NOT EXISTS kernel_results (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id INTEGER NOT NULL REFERENCES runs(id) ON DELETE CASCADE,
    kernel_name TEXT NOT NULL, time_ms REAL NOT NULL,
    ordinal INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_kernel_run ON kernel_results(run_id);
CREATE INDEX IF NOT EXISTS idx_kernel_name ON kernel_results(kernel_name);
CREATE TABLE IF NOT EXISTS metrics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id INTEGER NOT NULL REFERENCES runs(id) ON DELETE CASCADE,
    metric_name TEXT NOT NULL, metric_value REAL NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_metric_run ON metrics(run_id);
CREATE INDEX IF NOT EXISTS idx_metric_name ON metrics(metric_name);
"""

_interrupted = False

def _sigint_handler(signum, frame):
    global _interrupted
    _interrupted = True
    eprint("\n⚠  Interrupted — finishing current run, then saving partial results...")

def eprint(*a, **kw):
    print(*a, file=sys.stderr, **kw)

def run_cmd(cmd, timeout=30):
    """Run a shell command, return stdout stripped or None on failure."""
    try:
        p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = p.communicate(timeout=timeout)
        if p.returncode == 0:
            return out.decode("utf-8", errors="replace").strip()
    except Exception:
        pass
    return None

def find_repo_root():
    """Walk up from script location to find directory containing tier1/."""
    d = os.path.dirname(os.path.abspath(__file__))
    for _ in range(10):
        if os.path.isdir(os.path.join(d, "tier1")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    cwd = os.getcwd()
    if os.path.isdir(os.path.join(cwd, "tier1")):
        return cwd
    eprint("Error: cannot locate repo root (expected directory containing tier1/)")
    sys.exit(EXIT_USAGE)

# ── Platform detection ─────────────────────────────────────────────────────

_platform_cache = None

def detect_platform():
    if sys.platform == "darwin":
        return "metal"
    if os.path.isdir("/opt/rocm"):
        return "rocm"
    return "cuda"

def collect_platform_info(platform_type=None):
    global _platform_cache
    if _platform_cache is not None:
        return _platform_cache
    if platform_type is None:
        platform_type = detect_platform()

    info = dict(platform_type=platform_type, hostname=socket.gethostname(),
                os=None, cpu_model=None, cpu_cores=None, ram_gb=None,
                gpu_model="Unknown GPU", gpu_vram_gb=None, gpu_count=1,
                driver_version=None, runtime_version=None, compiler=None,
                python_version=platform.python_version())

    info["os"] = run_cmd("uname -srm") or "{} {}".format(
        platform.system(), platform.release())

    if sys.platform == "darwin":
        info["cpu_model"] = (run_cmd("sysctl -n machdep.cpu.brand_string") or
                             run_cmd("/usr/sbin/sysctl -n machdep.cpu.brand_string"))
        cores = (run_cmd("sysctl -n hw.logicalcpu") or
                 run_cmd("/usr/sbin/sysctl -n hw.logicalcpu"))
        if cores:
            try: info["cpu_cores"] = int(cores)
            except ValueError: pass
        memsize = (run_cmd("sysctl -n hw.memsize") or
                   run_cmd("/usr/sbin/sysctl -n hw.memsize"))
        if memsize:
            try: info["ram_gb"] = round(int(memsize) / (1024**3), 1)
            except ValueError: pass
    else:
        cpu = run_cmd("grep -m1 'model name' /proc/cpuinfo | sed 's/model name.*: //'")
        if cpu: info["cpu_model"] = cpu
        cores = run_cmd("nproc 2>/dev/null")
        if cores:
            try: info["cpu_cores"] = int(cores)
            except ValueError: pass
        mem = run_cmd("grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}'")
        if mem:
            try: info["ram_gb"] = round(int(mem) / (1024**2), 1)
            except ValueError: pass

    if platform_type == "cuda":
        gpu = run_cmd("nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1")
        if gpu: info["gpu_model"] = gpu
        vram = run_cmd("nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1")
        if vram:
            try: info["gpu_vram_gb"] = round(float(vram) / 1024, 1)
            except ValueError: pass
        drv = run_cmd("nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1")
        if drv: info["driver_version"] = drv
        nvcc = run_cmd("nvcc --version 2>/dev/null | grep 'release'")
        if nvcc:
            info["runtime_version"] = nvcc.strip()
            info["compiler"] = nvcc.strip()
        cnt = run_cmd("nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | wc -l")
        if cnt:
            try: info["gpu_count"] = int(cnt.strip())
            except ValueError: pass
    elif platform_type == "rocm":
        gpu = run_cmd("rocm-smi --showproductname 2>/dev/null | grep 'Card series' | head -1 | sed 's/.*: //'")
        if gpu: info["gpu_model"] = gpu
        drv = run_cmd("cat /opt/rocm/.info/version 2>/dev/null")
        if drv: info["driver_version"] = drv
        hipcc = run_cmd("hipcc --version 2>/dev/null | head -1")
        if hipcc:
            info["runtime_version"] = hipcc
            info["compiler"] = hipcc
    elif platform_type == "metal":
        sp = run_cmd("system_profiler SPDisplaysDataType 2>/dev/null")
        if sp:
            for line in sp.splitlines():
                ls = line.strip()
                if ls.startswith("Chipset Model:"):
                    info["gpu_model"] = ls.split(":", 1)[1].strip()
                elif "VRAM" in ls and ":" in ls:
                    parts = ls.split(":", 1)[1].strip().split()
                    if parts:
                        try: info["gpu_vram_gb"] = float(parts[0])
                        except ValueError: pass
                elif "Metal" in ls and ":" in ls:
                    info["driver_version"] = ls.split(":", 1)[1].strip()
        if info["gpu_model"] == "Unknown GPU" and info.get("cpu_model"):
            info["gpu_model"] = info["cpu_model"]
        mac_ver = run_cmd("sw_vers -productVersion 2>/dev/null")
        if mac_ver: info["runtime_version"] = "macOS {}".format(mac_ver)
        clang = run_cmd("clang++ --version 2>/dev/null | head -1")
        if clang: info["compiler"] = clang

    _platform_cache = info
    return info

# ── Benchmark discovery ────────────────────────────────────────────────────

def discover_benchmarks(repo_root, tier=None, suite=None, benchmark=None):
    results = []
    for pp in sorted(glob.glob(os.path.join(repo_root, "tier*", "*", "params.json"))):
        try:
            with open(pp) as f:
                params = json.load(f)
        except (IOError, ValueError):
            continue
        if tier is not None and params.get("tier") != tier:
            continue
        if suite is not None and params.get("suite") != suite:
            continue
        if benchmark is not None and params.get("benchmark") != benchmark:
            continue
        params["_dir"] = os.path.dirname(pp)
        params["_params_path"] = pp
        results.append(params)
    return results

def get_language(params):
    lang = params.get("language")
    if lang: return lang
    return "python" if params.get("tier", 1) >= 4 else "cpp"

# ── Command: list ──────────────────────────────────────────────────────────

def cmd_list(args):
    repo_root = find_repo_root()
    tier = int(args.tier) if args.tier else None
    benchmarks = discover_benchmarks(repo_root, tier=tier, suite=args.suite)
    if not benchmarks:
        eprint("No benchmarks found.")
        return EXIT_NO_BENCH

    if args.json:
        out = [{"tier": b["tier"], "suite": b["suite"],
                "benchmark": b["benchmark"],
                "scaling_param": b["scaling_param"]["name"],
                "kernels": len(b.get("kernels", [])),
                "language": get_language(b),
                "description": b.get("description", "")} for b in benchmarks]
        print(json.dumps(out, indent=2))
        return EXIT_OK

    fmt = "{:<5} {:<18} {:<28} {:<20} {:<8} {}"
    print(fmt.format("Tier", "Suite", "Benchmark", "Scaling Param", "Kernels", "Lang"))
    print(fmt.format("----", "-----", "---------", "-------------", "-------", "----"))
    tc = {}
    for b in benchmarks:
        t = b["tier"]
        tc[t] = tc.get(t, 0) + 1
        print(fmt.format(t, b["suite"], b["benchmark"],
                         b["scaling_param"]["name"],
                         len(b.get("kernels", [])), get_language(b)))
    parts = ["{} tier{}".format(tc[t], t) for t in sorted(tc)]
    print("\nTotal: {} benchmarks ({})".format(sum(tc.values()), ", ".join(parts)))
    return EXIT_OK

# ── Command: compile ───────────────────────────────────────────────────────

def cmd_compile(args):
    repo_root = find_repo_root()
    tier = int(args.tier) if args.tier else None
    plat = args.platform or detect_platform()
    benchmarks = discover_benchmarks(repo_root, tier=tier, suite=args.suite,
                                     benchmark=args.benchmark)
    if not benchmarks:
        eprint("No benchmarks found matching filters.")
        return EXIT_NO_BENCH

    cpp = [b for b in benchmarks if get_language(b) != "python"]
    skipped = len(benchmarks) - len(cpp)
    if not cpp:
        eprint("No C++ benchmarks to compile (skipped {} Python).".format(skipped))
        return EXIT_OK

    eprint("=== Compiling {} benchmarks (platform: {}) ===".format(len(cpp), plat))
    if skipped:
        eprint("  (skipping {} Python benchmarks)".format(skipped))

    passed = failed = 0
    failures = []
    for i, b in enumerate(cpp, 1):
        bname = b["benchmark"]
        eprint("[{:>3}/{}] {} ... ".format(i, len(cpp), bname), end="")
        try:
            proc = subprocess.Popen(
                ["make", "-C", b["_dir"], "PLATFORM={}".format(plat)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            out, err = proc.communicate(timeout=600)
            if proc.returncode == 0:
                eprint("✓"); passed += 1
            else:
                eprint("✗"); failed += 1; failures.append(bname)
                if args.verbose:
                    eprint(err.decode("utf-8", errors="replace"))
        except subprocess.TimeoutExpired:
            proc.kill(); proc.communicate()
            eprint("✗ (timeout)"); failed += 1; failures.append(bname)
        except Exception as e:
            eprint("✗ ({})".format(e)); failed += 1; failures.append(bname)

    eprint("\n=== Compile Summary ===")
    eprint("  Passed: {}  Failed: {}".format(passed, failed))
    if failures:
        eprint("  Failed: {}".format(", ".join(failures)))
    return EXIT_OK if failed == 0 else EXIT_SOME_FAILED

# ── Command: info ──────────────────────────────────────────────────────────

def cmd_info(args):
    plat = detect_platform()
    info = collect_platform_info(plat)
    if args.json:
        print(json.dumps(info, indent=2))
        return EXIT_OK

    print("Platform Information")
    print("  {:<14} {}".format("Platform:", info["platform_type"]))
    print("  {:<14} {}".format("GPU:", info["gpu_model"]))
    if info["gpu_vram_gb"]:
        print("  {:<14} {} GiB".format("GPU VRAM:", info["gpu_vram_gb"]))
    if info["driver_version"]:
        print("  {:<14} {}".format("Driver:", info["driver_version"]))
    if info["runtime_version"]:
        print("  {:<14} {}".format("Runtime:", info["runtime_version"]))
    if info["compiler"]:
        print("  {:<14} {}".format("Compiler:", info["compiler"]))
    print("  {:<14} {}".format("OS:", info["os"]))
    if info["cpu_model"]:
        c = " ({} cores)".format(info["cpu_cores"]) if info["cpu_cores"] else ""
        print("  {:<14} {}{}".format("CPU:", info["cpu_model"], c))
    if info["ram_gb"]:
        print("  {:<14} {} GiB".format("RAM:", info["ram_gb"]))
    print("  {:<14} {}".format("Hostname:", info["hostname"]))
    print("  {:<14} {}".format("Python:", info["python_version"]))
    return EXIT_OK

# ── Command: validate ──────────────────────────────────────────────────────

IDENT_RE = re.compile(r"^[a-z][a-z0-9_]*$")

def validate_params(params, params_path):
    """Validate a single params.json. Returns list of error strings."""
    errs = []
    bdir = os.path.dirname(params_path)
    dir_name = os.path.basename(bdir)
    tier_dir = os.path.basename(os.path.dirname(bdir))

    required = ["benchmark", "tier", "suite", "description",
                "scaling_param", "non_scaling_params", "kernels"]
    for f in required:
        if f not in params:
            errs.append("Missing required field: '{}'".format(f))
    if errs:
        return errs

    if params["benchmark"] != dir_name:
        errs.append("benchmark '{}' != directory '{}'".format(params["benchmark"], dir_name))
    try:
        tn = int(tier_dir.replace("tier", ""))
        if params["tier"] != tn:
            errs.append("tier {} != parent dir '{}'".format(params["tier"], tier_dir))
    except ValueError:
        errs.append("Parent dir '{}' not a tier pattern".format(tier_dir))

    sp = params.get("scaling_param", {})
    for f in ["name", "description", "type", "values"]:
        if f not in sp:
            errs.append("scaling_param missing '{}'".format(f))
    if "name" in sp and not IDENT_RE.match(sp["name"]):
        errs.append("scaling_param name '{}' not a valid identifier".format(sp["name"]))
    if "values" in sp and len(sp["values"]) < 10:
        errs.append("scaling_param needs >= 10 values, has {}".format(len(sp["values"])))

    all_names = []
    if "name" in sp:
        all_names.append(sp["name"])
    for idx, nsp in enumerate(params.get("non_scaling_params", [])):
        pfx = "non_scaling_params[{}]".format(idx)
        for f in ["name", "description", "type", "default", "values"]:
            if f not in nsp:
                errs.append("{} missing '{}'".format(pfx, f))
        if "name" in nsp:
            if not IDENT_RE.match(nsp["name"]):
                errs.append("{} name '{}' not a valid identifier".format(pfx, nsp["name"]))
            all_names.append(nsp["name"])
        if "default" in nsp and "values" in nsp and nsp["default"] not in nsp["values"]:
            errs.append("{} default {} not in values".format(pfx, json.dumps(nsp["default"])))

    seen = set()
    for n in all_names:
        if n in seen:
            errs.append("Duplicate parameter name: '{}'".format(n))
        seen.add(n)
    return errs

def cmd_validate(args):
    repo_root = find_repo_root()
    tier = int(args.tier) if args.tier else None
    benchmarks = discover_benchmarks(repo_root, tier=tier, suite=args.suite,
                                     benchmark=getattr(args, "benchmark", None))
    if not benchmarks:
        eprint("No benchmarks found matching filters.")
        return EXIT_NO_BENCH

    total_errors = valid = 0
    for b in benchmarks:
        pp = b["_params_path"]
        rel = os.path.relpath(pp, repo_root)
        try:
            with open(pp) as f:
                params = json.loads(f.read())
        except (ValueError, IOError) as e:
            print("✗ {} — Invalid JSON: {}".format(rel, e))
            total_errors += 1
            continue
        es = validate_params(params, pp)
        if es:
            print("✗ {}".format(rel))
            for e in es:
                print("    - {}".format(e))
            total_errors += len(es)
        else:
            print("✓ {}".format(rel))
            valid += 1

    print("\n=== Validation Summary ===")
    print("  Valid:  {}/{}".format(valid, len(benchmarks)))
    print("  Errors: {}".format(total_errors))
    return EXIT_OK if total_errors == 0 else EXIT_SOME_FAILED

# ── Database helpers ───────────────────────────────────────────────────────

def open_database(db_path):
    try:
        conn = sqlite3.connect(db_path)
        conn.executescript(SCHEMA_SQL)
        conn.execute("PRAGMA foreign_keys = ON")
        return conn
    except sqlite3.Error as e:
        eprint("Database error: {}".format(e))
        sys.exit(EXIT_DB)

def get_or_create_platform(conn, info):
    row = conn.execute(
        "SELECT id FROM platforms WHERE hostname=? AND gpu_model=? "
        "AND driver_version IS ? AND os=? AND platform_type=?",
        (info["hostname"], info["gpu_model"], info["driver_version"],
         info["os"], info["platform_type"])).fetchone()
    if row:
        return row[0]
    cur = conn.execute(
        "INSERT INTO platforms "
        "(hostname,os,cpu_model,cpu_cores,ram_gb,gpu_model,gpu_vram_gb,"
        "gpu_count,driver_version,runtime_version,compiler,platform_type,"
        "python_version) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (info["hostname"], info["os"], info["cpu_model"], info["cpu_cores"],
         info["ram_gb"], info["gpu_model"], info["gpu_vram_gb"],
         info["gpu_count"], info["driver_version"], info["runtime_version"],
         info["compiler"], info["platform_type"], info["python_version"]))
    conn.commit()
    return cur.lastrowid

def create_session(conn, platform_id, args, reps):
    cmd_line = " ".join(sys.argv)
    cur = conn.execute(
        "INSERT INTO sessions (platform_id,command_line,status,repetitions,"
        "filter_tier,filter_suite,filter_bench) VALUES (?,?,?,?,?,?,?)",
        (platform_id, cmd_line, "running", reps,
         str(args.tier) if args.tier else None,
         args.suite if hasattr(args, "suite") else None,
         args.benchmark if hasattr(args, "benchmark") else None))
    conn.commit()
    return cur.lastrowid

def finish_session(conn, session_id, status):
    try:
        conn.execute("UPDATE sessions SET finished_at=datetime('now'), status=? WHERE id=?",
                     (status, session_id))
        conn.commit()
    except sqlite3.Error:
        pass

# ── Benchmark execution helpers ────────────────────────────────────────────

def build_env(scaling_name, scaling_value, ns_dict):
    env = dict(os.environ)
    env["BENCH_PARAM_{}".format(scaling_name)] = str(scaling_value)
    for k, v in ns_dict.items():
        env["BENCH_PARAM_{}".format(k)] = str(v)
    return env

def get_bench_command(params, plat):
    bdir, lang, bname = params["_dir"], get_language(params), params["benchmark"]
    if lang == "python":
        if plat == "metal":
            mps = os.path.join(bdir, "bench_mps.py")
            if os.path.isfile(mps):
                return ["python3", mps]
        return ["python3", os.path.join(bdir, "bench.py")]
    return [os.path.join(bdir, bname)]

def parse_output(stdout_data):
    """Parse JSON-lines. Returns (kernels, summary, errors)."""
    kernels, summary, errors, ordinal = [], None, [], 0
    for line in stdout_data.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except (ValueError, json.JSONDecodeError if hasattr(json, 'JSONDecodeError') else ValueError):
            continue
        t = obj.get("type")
        if t == "kernel":
            obj["_ordinal"] = ordinal; ordinal += 1
            kernels.append(obj)
        elif t == "summary":
            summary = obj
        elif t == "error":
            errors.append(obj)
    return kernels, summary, errors

def run_benchmark_proc(cmd, env, timeout_secs, verbose=False):
    """Execute a benchmark. Returns (exit_code, stdout, stderr, timed_out)."""
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env)
    except OSError as e:
        return (1, "", str(e), False)
    try:
        out, err = proc.communicate(timeout=timeout_secs)
        return (proc.returncode,
                out.decode("utf-8", errors="replace"),
                err.decode("utf-8", errors="replace"), False)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            out, err = proc.communicate(timeout=5)
            return (-1, out.decode("utf-8", errors="replace"),
                    err.decode("utf-8", errors="replace"), True)
        except Exception:
            return (-1, "", "", True)

def generate_configs(params, sweep_ns=False, scaling_override=None):
    """Yield (scaling_value, non_scaling_dict) tuples."""
    sp = params["scaling_param"]
    sv_list = scaling_override if scaling_override else sp["values"]
    nsp_list = params.get("non_scaling_params", [])
    if not nsp_list:
        for sv in sv_list:
            yield sv, {}
        return
    if sweep_ns:
        names = [p["name"] for p in nsp_list]
        val_lists = [p["values"] for p in nsp_list]
        for sv in sv_list:
            for combo in itertools.product(*val_lists):
                yield sv, dict(zip(names, combo))
    else:
        defaults = {p["name"]: p["default"] for p in nsp_list}
        for sv in sv_list:
            yield sv, dict(defaults)

def format_duration(s):
    if s < 60: return "{:.1f}s".format(s)
    if s < 3600: return "{}m {}s".format(int(s // 60), int(s % 60))
    return "{}h {}m".format(int(s // 3600), int((s % 3600) // 60))

# ── Command: run ───────────────────────────────────────────────────────────

def cmd_run(args):
    global _interrupted
    repo_root = find_repo_root()
    tier = int(args.tier) if args.tier else None
    reps = int(args.reps) if args.reps else DEFAULT_REPS
    db_path = args.db or DEFAULT_DB
    plat = args.platform or detect_platform()
    timeout_secs = int(args.timeout) if args.timeout else DEFAULT_TIMEOUT
    dry_run, cont_err, verbose = args.dry_run, args.continue_on_error, args.verbose
    sweep_ns = args.sweep_non_scaling

    scaling_override = None
    if args.scaling_values:
        scaling_override = []
        for v in args.scaling_values.split(","):
            v = v.strip()
            try: scaling_override.append(int(v))
            except ValueError:
                try: scaling_override.append(float(v))
                except ValueError: scaling_override.append(v)

    benchmarks = discover_benchmarks(repo_root, tier=tier, suite=args.suite,
                                     benchmark=args.benchmark)
    if not benchmarks:
        eprint("No benchmarks found matching filters.")
        return EXIT_NO_BENCH

    total_runs = sum(len(list(generate_configs(b, sweep_ns, scaling_override))) * reps
                     for b in benchmarks)
    info = collect_platform_info(plat)

    eprint("=== GPU Benchmark Suite ===")
    eprint("Platform: {} ({})".format(plat.upper(), info["gpu_model"]))
    eprint("Database: {}".format(db_path))
    eprint("Repetitions: {}".format(reps))
    eprint("Benchmarks: {}".format(len(benchmarks)))
    eprint("Total runs: {}\n".format(total_runs))

    if dry_run:
        eprint("--- DRY RUN (no execution) ---\n")
        for idx, b in enumerate(benchmarks, 1):
            sp_name = b["scaling_param"]["name"]
            configs = list(generate_configs(b, sweep_ns, scaling_override))
            cmd = get_bench_command(b, plat)
            eprint("[{:>3}/{}] tier{}/{} ({})".format(
                idx, len(benchmarks), b["tier"], b["benchmark"], get_language(b)))
            eprint("  Scaling: {} ({} configs × {} reps = {} runs)".format(
                sp_name, len(configs), reps, len(configs) * reps))
            eprint("  Command: {}".format(" ".join(cmd)))
            sv_set = sorted(set(sv for sv, _ in configs),
                            key=lambda x: (0, x) if isinstance(x, (int, float)) else (1, str(x)))
            if len(sv_set) <= 10:
                eprint("  Values:  {}".format(", ".join(str(v) for v in sv_set)))
            else:
                eprint("  Values:  {} ... {} ({} values)".format(
                    sv_set[0], sv_set[-1], len(sv_set)))
            eprint()
        eprint("Total: {} runs across {} benchmarks".format(total_runs, len(benchmarks)))
        return EXIT_OK

    # Open DB, create session
    conn = open_database(db_path)
    platform_id = get_or_create_platform(conn, info)
    session_id = create_session(conn, platform_id, args, reps)
    old_handler = signal.signal(signal.SIGINT, _sigint_handler)
    total_passed = total_failed = 0
    start_time = time.time()

    try:
        for idx, b in enumerate(benchmarks, 1):
            if _interrupted:
                break
            sp_name = b["scaling_param"]["name"]
            configs = list(generate_configs(b, sweep_ns, scaling_override))
            eprint("[{:>3}/{}] tier{}/{}".format(idx, len(benchmarks), b["tier"], b["benchmark"]))
            eprint("  Scaling: {} ({} configs × {} reps = {} runs)".format(
                sp_name, len(configs), reps, len(configs) * reps))

            bp, bf = 0, 0
            cmd = get_bench_command(b, plat)

            for sv, ns_dict in configs:
                if _interrupted:
                    break
                for rep in range(1, reps + 1):
                    if _interrupted:
                        break
                    env = build_env(sp_name, sv, ns_dict)
                    eprint("    {}={:<12} rep {}/{}  ".format(sp_name, sv, rep, reps), end="")

                    ec, stdout_str, stderr_str, timed_out = run_benchmark_proc(
                        cmd, env, timeout_secs, verbose)
                    if verbose and stderr_str:
                        for sl in stderr_str.splitlines():
                            eprint("      [stderr] {}".format(sl))

                    kernels, summary, proto_errors = parse_output(stdout_str)

                    if timed_out:
                        status, err_msg = "timeout", "Timed out after {}s".format(timeout_secs)
                    elif ec != 0:
                        status = "error"
                        err_msg = proto_errors[0].get("message", "Exit code {}".format(ec)) if proto_errors else "Exit code {}".format(ec)
                    else:
                        status, err_msg = "ok", None

                    total_time = summary.get("total_time_ms") if summary else None

                    try:
                        cur = conn.execute(
                            "INSERT INTO runs (session_id,tier,suite,benchmark,"
                            "scaling_param_name,scaling_param_value,"
                            "non_scaling_params_json,repetition,status,"
                            "error_message,total_time_ms,exit_code,finished_at) "
                            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,datetime('now'))",
                            (session_id, b["tier"], b["suite"], b["benchmark"],
                             sp_name, str(sv), json.dumps(ns_dict), rep,
                             status, err_msg, total_time, ec))
                        run_id = cur.lastrowid
                        for kr in kernels:
                            conn.execute(
                                "INSERT INTO kernel_results (run_id,kernel_name,time_ms,ordinal) "
                                "VALUES (?,?,?,?)",
                                (run_id, kr.get("name", "unknown"),
                                 kr.get("time_ms", 0), kr.get("_ordinal", 0)))
                        if summary and "metrics" in summary:
                            for m in summary["metrics"]:
                                conn.execute(
                                    "INSERT INTO metrics (run_id,metric_name,metric_value) "
                                    "VALUES (?,?,?)",
                                    (run_id, m.get("name", "unknown"), m.get("value", 0)))
                        conn.commit()
                    except sqlite3.Error as e:
                        eprint("DB error: {}".format(e))
                        try: conn.rollback()
                        except Exception: pass

                    if status == "ok":
                        ts = "{:.3f}ms  ".format(total_time) if total_time is not None else ""
                        eprint("{}✓".format(ts)); bp += 1
                    elif status == "timeout":
                        eprint("✗ (timeout)"); bf += 1
                    else:
                        eprint("✗ ({})".format(err_msg or "error")); bf += 1

                    if not cont_err and bf > 0 and status != "ok":
                        break
                if not cont_err and bf > 0:
                    break

            total_passed += bp; total_failed += bf
            eprint("  {} {}/{} passed ({} failed)\n".format(
                "✓" if bf == 0 else "✗", bp, bp + bf, bf))
    finally:
        signal.signal(signal.SIGINT, old_handler)
        if _interrupted: ss = "interrupted"
        elif total_failed > 0: ss = "failed"
        else: ss = "completed"
        finish_session(conn, session_id, ss)
        eprint("=== Summary ===")
        eprint("  Total:   {} runs".format(total_passed + total_failed))
        eprint("  Passed:  {}".format(total_passed))
        eprint("  Failed:  {}".format(total_failed))
        eprint("  Time:    {}".format(format_duration(time.time() - start_time)))
        eprint("  Database: {}".format(db_path))
        conn.close()

    if _interrupted:
        return EXIT_INT
    return EXIT_OK if total_failed == 0 else EXIT_SOME_FAILED

# ── Argument parser ────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="gpubench",
        description="GPU Benchmark Suite CLI — compile, run, and analyze GPU benchmarks")
    sp = p.add_subparsers(dest="command", help="Command to run")

    # list
    ls = sp.add_parser("list", help="List available benchmarks")
    ls.add_argument("--tier", default=None, help="Filter by tier (1-5)")
    ls.add_argument("--suite", default=None, help="Filter by suite")
    ls.add_argument("--json", action="store_true", help="JSON output")

    # compile
    cc = sp.add_parser("compile", help="Compile C++ benchmarks")
    cc.add_argument("--tier", default=None)
    cc.add_argument("--suite", default=None)
    cc.add_argument("--benchmark", default=None)
    cc.add_argument("--platform", choices=["cuda", "rocm", "metal"], default=None)
    cc.add_argument("--jobs", type=int, default=None)
    cc.add_argument("--verbose", action="store_true")

    # run
    rn = sp.add_parser("run", help="Run benchmarks")
    rn.add_argument("--tier", default=None)
    rn.add_argument("--suite", default=None)
    rn.add_argument("--benchmark", default=None)
    rn.add_argument("--reps", default=None, help="Repetitions (default: 7)")
    rn.add_argument("--db", default=None, help="SQLite file (default: results.db)")
    rn.add_argument("--platform", choices=["cuda", "rocm", "metal"], default=None)
    rn.add_argument("--sweep-non-scaling", action="store_true")
    rn.add_argument("--timeout", default=None, help="Timeout secs (default: 300)")
    rn.add_argument("--scaling-values", default=None, help="Override values (csv)")
    rn.add_argument("--dry-run", action="store_true")
    rn.add_argument("--continue-on-error", action="store_true")
    rn.add_argument("--verbose", action="store_true")

    # info
    inf = sp.add_parser("info", help="Display platform information")
    inf.add_argument("--json", action="store_true")

    # validate
    vl = sp.add_parser("validate", help="Validate params.json files")
    vl.add_argument("--tier", default=None)
    vl.add_argument("--suite", default=None)
    vl.add_argument("--benchmark", default=None)

    return p

# ── Main ───────────────────────────────────────────────────────────────────

def main():
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(EXIT_USAGE)

    handlers = {"list": cmd_list, "compile": cmd_compile, "run": cmd_run,
                "info": cmd_info, "validate": cmd_validate}
    handler = handlers.get(args.command)
    if not handler:
        parser.print_help()
        sys.exit(EXIT_USAGE)
    try:
        sys.exit(handler(args))
    except SystemExit:
        raise
    except KeyboardInterrupt:
        eprint("\nInterrupted.")
        sys.exit(EXIT_INT)
    except Exception as e:
        eprint("Fatal error: {}".format(e))
        sys.exit(EXIT_SOME_FAILED)

if __name__ == "__main__":
    main()
