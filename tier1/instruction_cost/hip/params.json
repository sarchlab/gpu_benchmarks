{
  "benchmark": "instruction_cost",
  "tier": 1,
  "suite": "microbench",
  "description": "Times a hand-written gfx942 assembly loop whose body is exactly ops_per_iter copies of one instruction plus three loop-control instructions. AMD ROCm only. Emits raw GPU time; derive the per-instruction cost from the slope over ops_per_iter and the loop-control cost from the intercept.",
  "platforms": [
    "rocm"
  ],
  "scaling_param": {
    "name": "iterations",
    "description": "Loop iterations per thread; every iteration executes ops_per_iter copies of the instruction and the loop control",
    "type": "int",
    "values": [
      4096,
      16384,
      65536,
      262144
    ]
  },
  "non_scaling_params": [
    {
      "name": "instruction",
      "description": "The instruction repeated in the loop body",
      "type": "enum",
      "default": "v_fma_f32",
      "values": [
        "v_fma_f32",
        "v_mul_f32",
        "v_add_f32",
        "v_mul_lo_u32",
        "v_add_u32",
        "v_fma_f64",
        "v_pk_fma_f32",
        "v_mov_b64"
      ]
    },
    {
      "name": "dependency",
      "description": "chained: each copy reads the register the previous copy wrote. independent: copies read loop-invariant registers and write distinct ones",
      "type": "enum",
      "default": "chained",
      "values": [
        "chained",
        "independent"
      ]
    },
    {
      "name": "ops_per_iter",
      "description": "Copies of the instruction per loop iteration; 0 runs the loop control alone (the same kernel for every instruction and dependency)",
      "type": "int",
      "default": 4,
      "values": [
        0,
        1,
        2,
        4,
        8,
        16
      ]
    },
    {
      "name": "num_blocks",
      "description": "Number of thread blocks in the grid; the declared sweep uses one block",
      "type": "int",
      "default": 1,
      "values": [
        1
      ]
    },
    {
      "name": "threads_per_block",
      "description": "Threads per block; 64 is one wavefront, 256 is four wavefronts on one compute unit",
      "type": "int",
      "default": 64,
      "values": [
        64,
        256
      ]
    },
    {
      "name": "vector_add_warmup",
      "description": "When true, run the untimed vector-add warmer before each timed operation to raise clocks and disturb cache state; qualify the resulting state on the target. False disables the warmer without promising a particular cache state.",
      "type": "enum",
      "default": "true",
      "values": [
        "true",
        "false"
      ]
    }
  ],
  "kernels": [
    "ic_empty",
    "ic_v_fma_f32_chained_k1",
    "ic_v_fma_f32_chained_k2",
    "ic_v_fma_f32_chained_k4",
    "ic_v_fma_f32_chained_k8",
