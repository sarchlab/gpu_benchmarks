{
  "benchmark": "loop_wait",
  "tier": 1,
  "suite": "microbench",
  "description": "Times hand-written gfx942 assembly loops that each differ in one respect from the chained instruction_cost loop of the same instruction and ops_per_iter: the byte offset of the loop head in its 64-byte line, the position of the loop-control instructions, or a scalar-register operand. AMD ROCm only. Emits raw GPU time; compare the time per iteration with that instruction_cost kernel.",
  "platforms": [
    "rocm"
  ],
  "scaling_param": {
    "name": "iterations",
    "description": "Loop iterations per thread; every iteration executes ops_per_iter copies of the instruction and the loop control",
    "type": "int",
    "values": [
      4096,
      16384,
      65536,
      262144
    ]
  },
  "non_scaling_params": [
    {
      "name": "layout",
      "description": "How the loop differs from the instruction_cost loop. head_offset_N: the loop head is N bytes into its 64-byte line. add_at_head: the counter decrement is the first instruction of the loop. valu_before_branch: one VALU instruction sits between the compare and the branch. compiled: both, with the decrement after the first VALU instruction. sgpr_at_head, sgpr_in_middle: the first VALU instruction, or the one in the middle, reads one operand from a scalar register",
      "type": "enum",
      "default": "head_offset_8",
      "values": [
        "head_offset_8",
        "head_offset_20",
        "head_offset_28",
        "head_offset_52",
        "add_at_head",
        "valu_before_branch",
        "compiled",
        "sgpr_at_head",
        "sgpr_in_middle"
      ]
    },
    {
      "name": "instruction",
      "description": "The VALU instruction repeated in the loop body",
      "type": "enum",
      "default": "v_fma_f32",
      "values": [
        "v_fma_f32",
        "v_mul_f32",
        "v_add_f32",
        "v_mul_lo_u32",
        "v_add_u32",
        "v_fma_f64",
        "v_pk_fma_f32",
        "v_mov_b64"
      ]
    },
    {
      "name": "ops_per_iter",
      "description": "Copies of the instruction per loop iteration",
      "type": "int",
      "default": 4,
      "values": [
        2,
        4,
        8,
        16
      ]
    },
    {
      "name": "num_blocks",
      "description": "Number of thread blocks in the grid; the declared sweep uses one block",
      "type": "int",
      "default": 1,
      "values": [
        1
      ]
    },
    {
      "name": "threads_per_block",
      "description": "Threads per block; the declared sweep uses 64, one wavefront",
      "type": "int",
      "default": 64,
      "values": [
        64
      ]
    },
    {
      "name": "vector_add_warmup",
      "description": "When true, run the untimed vector-add warmer before each timed operation to raise clocks and disturb cache state; qualify the resulting state on the target. False disables the warmer without promising a particular cache state.",
      "type": "enum",
      "default": "true",
      "values": [
        "true",
        "false"
      ]
    }
  ],
