{
  "benchmark": "heteromark_aes",
  "tier": 2,
  "suite": "heteromark",
  "description": "AES-256 ECB encryption on GPU. Each thread encrypts one 16-byte block through 14 rounds. Measures throughput in GB/s.",
  "scaling_param": {
    "name": "size",
    "description": "Number of 16-byte blocks to encrypt",
    "type": "int",
    "values": [
      1024,
      2048,
      4096,
      8192,
      16384,
      32768,
      65536,
      131072,
      262144,
      524288,
      1048576,
      2097152,
      4194304,
      8388608,
      16777216,
      33554432,
      67108864,
      134217728,
      268435456,
      536870912
    ]
  },
  "non_scaling_params": [
    {
      "name": "iterations",
      "description": "Timed benchmark iterations",
      "type": "int",
      "default": 5,
      "values": [
        3,
        5,
        10,
        20
      ]
    },
    {
      "name": "block_size",
      "description": "Number of threads per block",
      "type": "int",
      "default": 256,
      "values": [
        64,
        128,
        256,
        512
      ]
    },
    {
      "name": "key_length",
      "description": "AES key length in bits",
      "type": "enum",
      "default": "256",
      "values": [
        "128",
        "192",
        "256"
      ]
    }
  ],
  "kernels": [
    "aes256_encrypt_kernel"
  ]
}
