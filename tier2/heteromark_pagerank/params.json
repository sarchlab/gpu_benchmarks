{
  "benchmark": "heteromark_pagerank",
  "tier": 2,
  "suite": "heteromark",
  "description": "Iterative PageRank (power method) on a synthetic Erdos-Renyi CSR graph. PR[v] = (1-d)/N + d * sum(PR[u]/degree[u]). Measures edges/sec.",
  "scaling_param": {
    "name": "vertices",
    "description": "Number of vertices in the synthetic graph",
    "type": "int",
    "values": [
      1024,
      1536,
      2048,
      3072,
      4096,
      6144,
      8192,
      12288,
      16384,
      24576,
      32768,
      49152,
      65536,
      98304,
      131072,
      196608,
      262144,
      393216,
      524288,
      786432,
      1048576,
      1572864,
      2097152,
      3145728,
      4194304,
      6291456,
      8388608
    ]
  },
  "non_scaling_params": [
    {
      "name": "pr_iterations",
      "description": "Number of PageRank iterations per run",
      "type": "int",
      "default": 20,
      "values": [
        5,
        10,
        20,
        50,
        100
      ]
    },
    {
      "name": "damping_factor",
      "description": "PageRank damping factor",
      "type": "float",
      "default": 0.85,
      "values": [
        0.7,
        0.8,
        0.85,
        0.9
      ]
    }
  ],
  "kernels": [
    "pagerank_kernel"
  ]
}
