      512,
      1024,
      2048,
      4096,
      8192,
      16384,
      32768,
      65536,
      131072,
      262144,
      524288,
      1048576,
      2097152,
      4194304,
      8388608,
      16777216,
      33554432,
      67108864,
      134217728
    ]
  },
  "non_scaling_params": [
    {
      "name": "timesteps",
      "description": "Number of simulation timesteps",
      "type": "int",
      "default": 10,
      "values": [
        1,
        5,
        10,
        20
      ]
    },
    {
      "name": "theta",
      "description": "Barnes-Hut opening angle (controls accuracy vs speed tradeoff)",
      "type": "float",
      "default": 0.5,
      "values": [
