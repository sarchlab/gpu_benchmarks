      6144,
      8192,
      12288,
      16384,
      24576,
      32768,
      49152,
      65536,
      98304,
      131072,
      196608,
      262144,
      393216,
      524288,
      786432,
      1048576,
      1572864,
      2097152,
      3145728,
      4194304,
      6291456,
      8388608
