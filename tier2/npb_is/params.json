{
  "benchmark": "npb_is",
  "tier": 2,
  "suite": "npb",
  "description": "NAS Parallel Benchmarks Integer Sort: parallel bucket sort of N random integers. Three-phase: histogram, prefix-sum scan, scatter. NUM_BUCKETS=1024.",
  "scaling_param": {
    "name": "size",
    "description": "Number of integer keys to sort",
    "type": "int",
    "values": [
      1024,
      2048,
      4096,
      8192,
      16384,
      32768,
      65536,
      131072,
      262144,
      1048576,
      2097152,
      4194304,
      8388608,
      16777216,
      33554432,
      67108864,
      134217728,
      268435456,
      536870912,
      1073741824
    ]
  },
  "non_scaling_params": [
    {
      "name": "iterations",
      "description": "Timed benchmark iterations",
      "type": "int",
      "default": 5,
      "values": [
        3,
        5,
        10,
        20
      ]
    },
    {
      "name": "block_size",
      "description": "Number of threads per block",
      "type": "int",
      "default": 256,
      "values": [
        64,
        128,
        256,
        512
      ]
    },
    {
      "name": "verify",
      "description": "Enable CPU verification of results",
      "type": "enum",
      "default": "true",
      "values": [
        "true",
        "false",
        "skip"
      ]
    }
  ],
  "kernels": [
    "histogram_kernel",
    "prefix_sum_kernel",
    "scatter_kernel"
  ]
}
