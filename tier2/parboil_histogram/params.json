{
  "benchmark": "parboil_histogram",
  "tier": 2,
  "suite": "parboil",
  "description": "256-bin histogram of N random uint32 values using atomic operations. Each element mapped to a bin via lower 8 bits. Measures throughput in GB/s.",
  "scaling_param": {
    "name": "n",
    "description": "Number of input uint32 elements",
    "type": "int",
    "values": [
      1024,
      1536,
      2048,
      3072,
      4096,
      6144,
      8192,
      12288,
      16384,
      24576,
      32768,
      49152,
      65536,
      98304,
      131072,
      196608,
      262144,
      393216,
      524288,
      786432,
      1048576,
      1572864,
      2097152,
      3145728,
      4194304,
      6291456,
      8388608
    ]
  },
  "non_scaling_params": [
    {
      "name": "num_bins",
      "description": "Number of histogram bins",
      "type": "int",
      "default": 256,
      "values": [
        64,
        256,
        1024
      ]
    },
    {
      "name": "block_size",
      "description": "Number of threads per block",
      "type": "int",
      "default": 256,
      "values": [
        256
      ]
    }
  ],
  "kernels": [
    "histogram_kernel"
  ]
}
