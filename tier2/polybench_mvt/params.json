{
  "benchmark": "polybench_mvt",
  "tier": 2,
  "suite": "polybench",
  "description": "Matrix-vector product and transpose: x1 = A * y1, x2 = A^T * y2 for NxN matrix A. Emits per-iteration kernel times; memory bandwidth (GB/s) is derived downstream.",
  "scaling_param": {
    "name": "n",
    "description": "Matrix dimension N (NxN matrix A)",
    "type": "int",
    "values": [
      64,
      128,
      256,
      512,
      768,
      1024,
      1536,
      2048,
      2560,
      3072,
      4096,
      5120,
      6144,
      7168,
      8192,
      10240,
      12288,
      16384,
      20480,
      24576,
      32768
    ]
  },
  "non_scaling_params": [
    {
      "name": "block_size",
      "description": "Number of threads per block",
      "type": "int",
      "default": 256,
      "values": [
        256
      ]
    },
    {
      "name": "precision",
      "description": "Floating-point precision for computation",
      "type": "enum",
      "default": "float",
      "values": [
        "float"
      ]
    }
  ],
  "kernels": [
    "mvt_kernel1",
    "mvt_kernel2"
  ]
}
