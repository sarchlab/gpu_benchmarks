{
  "benchmark": "rodinia_hotspot",
  "tier": 2,
  "suite": "rodinia",
  "description": "Iterative 2D stencil thermal simulation for chip temperature estimation. Updates each cell based on four neighbors, local power density, and thermal resistances.",
  "scaling_param": {
    "name": "grid_size",
    "description": "Grid dimension (NxN temperature grid)",
    "type": "int",
    "values": [64, 128, 192, 256, 384, 512, 640, 768, 1024, 1280, 1536, 2048, 2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192]
  },
  "non_scaling_params": [
    {
      "name": "block_size",
      "description": "Thread-block dimension (BxB threads)",
      "type": "int",
      "default": 16,
      "values": [8, 16, 32]
    },
    {
      "name": "num_iterations",
      "description": "Stencil time-steps per timed launch",
      "type": "int",
      "default": 10,
      "values": [1, 5, 10, 20, 50]
    },
    {
      "name": "iterations",
      "description": "Timed benchmark iterations",
      "type": "int",
      "default": 20,
      "values": [5, 10, 20]
    }
  ],
  "kernels": ["hotspot_kernel"]
}
