{
  "benchmark": "rodinia_kmeans",
  "tier": 2,
  "suite": "rodinia",
  "description": "K-means clustering: assigns N D-dimensional points to K clusters, iteratively updating centers until convergence. Measures throughput in Gpoints/s.",
  "scaling_param": {
    "name": "points",
    "description": "Number of data points to cluster",
    "type": "int",
    "values": [
      1024,
      2048,
      4096,
      8192,
      16384,
      32768,
      65536,
      131072,
      262144,
      524288,
      1048576,
      2097152,
      4194304,
      8388608,
      16777216,
      33554432,
      67108864,
      134217728,
      268435456,
      536870912
    ]
  },
  "non_scaling_params": [
    {
      "name": "dims",
      "description": "Number of dimensions per data point",
      "type": "int",
      "default": 16,
      "values": [
        2,
        4,
        8,
        16,
        32
      ]
    },
    {
      "name": "clusters",
      "description": "Number of clusters (K)",
      "type": "int",
      "default": 8,
      "values": [
        4,
        8,
        16,
        32,
        64
      ]
    },
    {
      "name": "max_iter",
      "description": "Maximum number of K-means iterations",
      "type": "int",
      "default": 10,
      "values": [
        5,
        10,
        20,
        50
      ]
    }
  ],
  "kernels": [
    "kmeans_assign_kernel",
    "kmeans_update_kernel"
  ]
}
