{
  "benchmark": "shoc_fft",
  "tier": 2,
  "suite": "shoc",
  "description": "Cooley-Tukey radix-2 iterative FFT on N complex elements (float2). Measures throughput in GFLOPS.",
  "scaling_param": {
    "name": "size",
    "description": "FFT size in complex elements (must be power of 2)",
    "type": "int",
    "values": [
      1024,
      2048,
      4096,
      8192,
      16384,
      32768,
      65536,
      131072,
      262144,
      524288,
      1048576,
      2097152,
      4194304,
      8388608
    ]
  },
  "non_scaling_params": [
    {
      "name": "precision",
      "description": "Floating-point precision for FFT computation",
      "type": "enum",
      "default": "float",
      "values": [
        "float",
        "double",
        "half"
      ]
    },
    {
      "name": "batch_count",
      "description": "Number of FFT batches to execute",
      "type": "int",
      "default": 1,
      "values": [
        1,
        2,
        4,
        8
      ]
    }
  ],
  "kernels": [
    "bit_reverse_kernel",
    "fft_butterfly_kernel"
  ]
}
