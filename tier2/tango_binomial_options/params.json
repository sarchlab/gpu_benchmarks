  },
  "non_scaling_params": [
    {
      "name": "steps",
      "description": "Number of steps in the binomial tree per option",
      "type": "int",
      "default": 1024,
      "values": [128, 256, 512, 1024, 2048]
    },
    {
      "name": "iterations",
      "description": "Timed benchmark iterations",
      "type": "int",
      "default": 5,
      "values": [3, 5, 10, 20]
    }
  ],
  "kernels": ["binomial_kernel"]
}
