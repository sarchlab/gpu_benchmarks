    "scaling_param": {
        "name": "s",
        "description": "Sequence length (number of tokens); attention is O(S^2) in computation",
        "type": "int",
        "values": [
            64,
            96,
            128,
            192,
            256,
            384,
            512,
            640,
            768,
            1024,
            1280,
            1536,
            2048,
            2560,
            3072,
            4096,
            5120,
            6144,
            8192,
            10240,
            12288,
            16384
        ]
    },
    "non_scaling_params": [
        {
            "name": "b",
            "description": "Batch size",
            "type": "int",
            "default": 2,
            "values": [
                1,
                2,
                4,
                8
            ]
        },
        {
            "name": "h",
            "description": "Number of attention heads",
            "type": "int",
            "default": 16,
            "values": [
                4,
                8,
                16,
                32
            ]
        },
        {
            "name": "d",
            "description": "Head dimension (embedding size per head)",
            "type": "int",
            "default": 64,
            "values": [
                32,
                64,
                128
            ]
        },
        {
            "name": "block_m",
            "description": "Tile size along the query sequence dimension",
            "type": "int",
            "default": 128,
            "values": [
                64,
                128,
                256
            ]
        },
        {
            "name": "block_n",
            "description": "Tile size along the key/value sequence dimension",
            "type": "int",
            "default": 64,
            "values": [
                32,
                64,
                128
            ]
        }
    ],
    "kernels": [
        "flash_attention_fwd"
    ]
}
