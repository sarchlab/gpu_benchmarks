{
    "benchmark": "triton_flash_attention",
    "tier": 4,
    "suite": "triton",
    "description": "Flash Attention forward pass using online softmax in Triton. Computes scaled dot-product attention (Q @ K^T / sqrt(D), softmax, @ V) with tiled I/O to avoid materializing the full attention matrix. Measures throughput in TFLOPS.",
