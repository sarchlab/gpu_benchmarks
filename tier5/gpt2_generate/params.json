{
  "benchmark": "gpt2_generate",
  "tier": 5,
  "suite": "ml_generation",
  "description": "GPT-2-style autoregressive text generation benchmark. Generates tokens one at a time from a prompt using argmax sampling. Reports tokens/sec throughput.",
  "language": "python",
  "scaling_param": {
    "name": "num_new_tokens",
    "description": "Number of new tokens to generate autoregressively",
    "type": "int",
    "values": [
      8, 16, 24, 32, 48, 64, 96, 128, 160, 192,
      224, 256, 320, 384, 448, 512, 640, 768, 896, 1024,
      1280, 1536, 1792, 2048
    ]
  },
  "non_scaling_params": [
    {
      "name": "prompt_len",
      "description": "Length of the input prompt in tokens",
      "type": "int",
      "default": 32,
      "values": [8, 16, 32, 64, 128]
    },
    {
      "name": "n_layer",
      "description": "Number of transformer blocks",
      "type": "int",
      "default": 6,
      "values": [2, 4, 6, 12]
    },
    {
      "name": "n_embd",
      "description": "Embedding dimension (model width)",
      "type": "int",
      "default": 384,
      "values": [128, 256, 384, 768]
    },
    {
      "name": "n_head",
      "description": "Number of attention heads",
      "type": "int",
      "default": 6,
      "values": [2, 4, 6, 12]
    }
  ],
  "kernels": ["forward", "generate"]
}
