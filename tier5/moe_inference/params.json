      "description": "Number of MoE transformer blocks",
      "type": "int",
      "default": 4,
      "values": [
        2,
        4,
        6,
        8
      ]
    },
    {
      "name": "hidden_size",
      "description": "Hidden dimension of the model",
      "type": "int",
      "default": 512,
      "values": [
        256,
        512,
        1024
      ]
    }
  ],
  "kernels": [
    "forward",
    "gating",
    "expert_forward",
    "generate"
  ]
}
