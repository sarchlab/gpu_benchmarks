{
  "benchmark": "moe_inference",
  "tier": 5,
  "suite": "ml_inference",
  "description": "Mixture-of-Experts transformer inference benchmark with top-k gating. Custom MoE transformer model with token routing to expert FFN sub-networks. Generates tokens autoregressively. Reports tokens/sec throughput.",
