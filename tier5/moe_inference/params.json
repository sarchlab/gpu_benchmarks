  "scaling_param": {
    "name": "num_new_tokens",
    "description": "Number of new tokens to generate autoregressively",
    "type": "int",
    "values": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      80,
      96,
      112,
      128,
      160,
      192,
      224,
      256,
      320,
      384,
      448,
      512,
      640,
      768,
      896,
      1024
    ]
  },
  "non_scaling_params": [
    {
      "name": "seq_len",
      "description": "Length of the input prompt in tokens",
      "type": "int",
      "default": 256,
      "values": [
        64,
        128,
        256,
        512
      ]
    },
    {
      "name": "num_experts",
      "description": "Number of expert FFN sub-networks",
      "type": "int",
      "default": 4,
      "values": [
        4,
