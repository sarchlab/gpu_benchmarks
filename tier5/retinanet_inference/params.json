      3,
      4,
      5,
      6,
      8,
      10,
      12,
      14,
      16,
      20,
      24,
      28,
      32,
      36,
      40,
      48,
      56,
      64,
      72,
      80,
      96,
      112,
      128
    ]
  },
  "non_scaling_params": [
    {
      "name": "image_size",
      "description": "Spatial resolution of input images (height and width)",
      "type": "int",
      "default": 640,
      "values": [
        320,
        480,
        640,
        800,
        1024
      ]
    },
    {
      "name": "num_classes",
      "description": "Number of object detection classes",
      "type": "int",
